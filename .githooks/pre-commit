#!/usr/bin/env bash
# Validates the data and keeps README.md's conference list current on every commit
# that touches data/ or scripts/. Replaces the GitHub Actions workflows, so nothing
# here depends on Actions minutes. Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# The validators read the working tree, not the index, so commit the whole file you
# edited rather than a partial staging of it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -qE '^(data|scripts)/'; then
  exit 0
fi

python3 scripts/validate_conferences.py
python3 scripts/validate_schedules.py

# The generator only rewrites the block between the markers, so staging README.md
# can pick up nothing else from the working tree.
python3 scripts/generate_readme.py >/dev/null
if ! git diff --quiet -- README.md; then
  git add README.md
  echo "README.md: regenerated and added to this commit."
fi
